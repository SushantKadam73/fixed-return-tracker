  "conventions": {
    "compounding": "Annual rate, credited on monthly running balance (compound effect via monthly balance method), credited to account at financial year-end",
    "declaration": "Recommended annually by EPFO's Central Board of Trustees (CBT), typically Feb-Mar for the FY about to end; sent to Ministry of Finance for concurrence; officially notified by Ministry of Labour & Employment; often credited to accounts several months into the following FY after ratification",
    "administeredBy": "Employees' Provident Fund Organisation (EPFO), Ministry of Labour & Employment, with Finance Ministry concurrence",
    "currentQuarter": {
      "note": "EPF rate is declared per FULL FINANCIAL YEAR, not quarterly. As of this research date (2026-09-27, within FY2026-27), the last declared/credited rate is FY2025-26 = 8.25% (CBT recommendation 2026-03-02, ratified by Finance Ministry June 2026). FY2026-27's rate is NOT yet declared -- expected to be recommended by CBT around Feb-Mar 2027 and ratified/credited months later, per the pattern of the last several years.",
      "lastDeclaredRate": 8.25,
      "lastDeclaredFY": "2025-26",
      "sourceUrl": "https://www.pib.gov.in/PressReleasePage.aspx?PRID=2234502",
      "sourceType": "primary"
    }
