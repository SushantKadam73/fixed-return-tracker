# ── Website (Vercel) ─────────────────────────────────────────────
# Set automatically at build time when CONVEX_DEPLOY_KEY is present (see scripts/vercel-build.sh).
NEXT_PUBLIC_CONVEX_URL=
# Build-time only: lets Vercel deploy the Convex functions (Convex dashboard → Settings → Deploy keys → Production).
CONVEX_DEPLOY_KEY=
# Shared secret that Convex uses to ask the site to refresh cached pages (any long random string).
REVALIDATE_SECRET=

# ── Convex (set with `npx convex env set NAME value`, or in the Convex dashboard) ─────────
# Shared secret the collectors send when posting results to Convex (any long random string).
# INGEST_SECRET=
# Where Convex should call after new data arrives, e.g. https://<your-site>.vercel.app/api/revalidate
# SITE_REVALIDATE_URL=
# Same value as REVALIDATE_SECRET above.
# REVALIDATE_SECRET=
# Optional: lets the Convex watchdog restart the collector workflow if it stops (GitHub pauses
# schedules after 60 days without repo activity). Fine-grained token, this repo only, "Actions: read and write".
# GITHUB_DISPATCH_TOKEN=

# ── GitHub Actions secrets (repo → Settings → Secrets and variables → Actions) ───────────
# CONVEX_SITE_URL   = https://<deployment>.convex.site   (Convex HTTP endpoint base)
# INGEST_SECRET     = same value as in Convex
